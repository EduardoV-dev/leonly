generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String        @id
  name          String
  email         String        @unique
  emailVerified Boolean       @default(false) @map("email_verified")
  image         String?
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  sessions      Session[]
  accounts      Account[]
  createdSpaces Space[]       @relation("SpaceCreator")
  updatedSpaces Space[]       @relation("SpaceUpdater")
  spaceMembers  SpaceMember[]
  files         File[]
  memories      Memory[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime @map("expires_at")
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verification")
}

enum SpaceMemberRole {
  owner
  partner

  @@map("space_member_role")
}

model Space {
  id                  String        @id @default(dbgenerated("private.uuid_v7()")) @db.Uuid
  name                String
  startDate           DateTime      @map("start_date") @db.Date
  inviteCode          String?       @map("invite_code")
  inviteCodeExpiresAt DateTime?     @map("invite_code_expires_at") @db.Timestamptz(6)
  createdByUserId     String        @map("created_by_user_id")
  createdByUser       User          @relation("SpaceCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  updatedByUserId     String        @map("updated_by_user_id")
  updatedByUser       User          @relation("SpaceUpdater", fields: [updatedByUserId], references: [id], onDelete: Restrict)
  deletedAt           DateTime?     @map("deleted_at") @db.Timestamptz(6)
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  members             SpaceMember[]
  files               File[]
  memories            Memory[]

  @@index([createdByUserId], map: "spaces_created_by_user_id")
  @@index([updatedByUserId], map: "spaces_updated_by_user_id")
  @@map("spaces")
}

model SpaceMember {
  id                    String          @id @default(dbgenerated("private.uuid_v7()")) @db.Uuid
  spaceId               String          @map("space_id") @db.Uuid
  space                 Space           @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId                String          @map("user_id")
  user                  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName           String          @map("display_name")
  role                  SpaceMemberRole
  onboardingCompletedAt DateTime?       @map("onboarding_completed_at") @db.Timestamptz(6)
  deletedAt             DateTime?       @map("deleted_at") @db.Timestamptz(6)
  createdAt             DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdMemories       Memory[]
  reactions             MemoryReaction[]
  comments              MemoryComment[]

  @@unique([id, userId, spaceId], map: "space_members_id_user_space_unique")
  @@unique([id, spaceId], map: "space_members_id_space_unique")
  @@index([spaceId], map: "space_members_space_id")
  @@map("space_members")
}

enum FilePurpose {
  memory_image

  @@map("file_purpose")
}

enum FileStatus {
  pending
  uploaded
  ready
  failed
  deleting

  @@map("file_status")
}

enum MemoryVisibility {
  timeline
  vault

  @@map("memory_visibility")
}

enum MemoryReactionType {
  heart
  laugh
  cry
  star

  @@map("memory_reaction_type")
}

model File {
  id                     String      @id @default(dbgenerated("private.uuid_v7()")) @db.Uuid
  spaceId                String      @map("space_id") @db.Uuid
  space                  Space       @relation(fields: [spaceId], references: [id], onDelete: Restrict)
  uploadedByUserId       String      @map("uploaded_by_user_id")
  uploadedBy             User        @relation(fields: [uploadedByUserId], references: [id], onDelete: Restrict)
  originalFileId         String?     @map("original_file_id") @db.Uuid
  originalFile           File?       @relation("FileVariants", fields: [originalFileId, spaceId], references: [id, spaceId], onDelete: Restrict, onUpdate: NoAction)
  variants               File[]      @relation("FileVariants")
  variantName            String?     @map("variant_name")
  objectKey              String      @map("object_key")
  originalFilename       String?     @map("original_filename")
  mimeType               String      @map("mime_type")
  sizeBytes              BigInt?     @map("size_bytes")
  purpose                FilePurpose
  status                 FileStatus  @default(pending)
  operationLockToken     String?     @map("operation_lock_token") @db.Uuid
  operationLockExpiresAt DateTime?   @map("operation_lock_expires_at") @db.Timestamptz(6)
  lastErrorCode          String?     @map("last_error_code")
  createdAt              DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  memoryFiles            MemoryFile[]

  @@unique([id, spaceId], map: "files_id_space_unique")
  @@unique([objectKey], map: "files_object_key_unique")
  @@unique([originalFileId, variantName], map: "files_original_variant_unique")
  @@index([status, createdAt], map: "files_status_created_at")
  @@index([spaceId, uploadedByUserId], map: "files_space_uploader")
  @@map("files")
}

model Memory {
  id                  String           @id @default(dbgenerated("private.uuid_v7()")) @db.Uuid
  spaceId             String           @map("space_id") @db.Uuid
  space               Space            @relation(fields: [spaceId], references: [id], onDelete: Restrict)
  createdByUserId     String           @map("created_by_user_id")
  createdByUser       User             @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  createdByMemberId   String           @map("created_by_member_id") @db.Uuid
  createdByMember     SpaceMember      @relation(fields: [createdByMemberId, createdByUserId, spaceId], references: [id, userId, spaceId], onDelete: Restrict, onUpdate: NoAction)
  coverFileId         String?          @map("cover_file_id") @db.Uuid
  coverFile           MemoryFile?      @relation("MemoryCover", fields: [id, coverFileId], references: [memoryId, fileId], onDelete: NoAction, onUpdate: NoAction)
  title               String
  description         String?
  location            String?
  memoryDate          DateTime         @map("memory_date") @db.Date
  visibility          MemoryVisibility
  deletedAt           DateTime?        @map("deleted_at") @db.Timestamptz(6)
  idempotencyKey      String           @map("idempotency_key") @db.Uuid
  creationRequestHash String           @map("creation_request_hash")
  createdAt           DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  memoryFiles         MemoryFile[]     @relation("MemoryFiles")
  reactions           MemoryReaction[]
  comments            MemoryComment[]

  @@unique([spaceId, createdByUserId, idempotencyKey], map: "memories_creation_key_unique")
  @@unique([id, spaceId], map: "memories_id_space_unique")
  @@index([createdByMemberId, createdByUserId, spaceId], map: "memories_creator_membership")
  @@map("memories")
}

model MemoryComment {
  id                 String          @id @default(dbgenerated("private.uuid_v7()")) @db.Uuid
  memoryId           String          @map("memory_id") @db.Uuid
  spaceId            String          @map("space_id") @db.Uuid
  authorMembershipId String          @map("author_membership_id") @db.Uuid
  parentCommentId    String?         @map("parent_comment_id") @db.Uuid
  body               String
  deletedAt          DateTime?       @map("deleted_at") @db.Timestamptz(6)
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  memory             Memory          @relation(fields: [memoryId, spaceId], references: [id, spaceId], onDelete: Restrict, onUpdate: NoAction)
  author             SpaceMember     @relation(fields: [authorMembershipId, spaceId], references: [id, spaceId], onDelete: Restrict, onUpdate: NoAction)
  parent             MemoryComment?  @relation("CommentReplies", fields: [parentCommentId, memoryId, spaceId], references: [id, memoryId, spaceId], onDelete: NoAction, onUpdate: NoAction)
  replies            MemoryComment[] @relation("CommentReplies")

  @@unique([id, memoryId, spaceId], map: "memory_comments_id_memory_space_unique")
  @@index([memoryId, spaceId, parentCommentId, createdAt, id], map: "memory_comments_thread_order")
  @@map("memory_comments")
}

model MemoryReaction {
  id                String             @id @default(dbgenerated("private.uuid_v7()")) @db.Uuid
  spaceId           String             @map("space_id") @db.Uuid
  memoryId          String             @map("memory_id") @db.Uuid
  memory            Memory             @relation(fields: [memoryId, spaceId], references: [id, spaceId], onDelete: Cascade, onUpdate: NoAction)
  reactedByMemberId String             @map("reacted_by_member_id") @db.Uuid
  reactedByMember   SpaceMember        @relation(fields: [reactedByMemberId, spaceId], references: [id, spaceId], onDelete: Cascade, onUpdate: NoAction)
  reactionType      MemoryReactionType @map("reaction_type")
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([reactedByMemberId, memoryId], map: "memory_reactions_member_memory_unique")
  @@index([memoryId], map: "memory_reactions_memory_id")
  @@map("memory_reactions")
}

model MemoryFile {
  memoryId String @map("memory_id") @db.Uuid
  fileId   String @map("file_id") @db.Uuid
  spaceId  String @map("space_id") @db.Uuid
  position Int    @db.SmallInt

  memory        Memory  @relation("MemoryFiles", fields: [memoryId, spaceId], references: [id, spaceId], onDelete: Restrict, onUpdate: NoAction)
  file          File    @relation(fields: [fileId, spaceId], references: [id, spaceId], onDelete: Restrict, onUpdate: NoAction)
  coveredMemories Memory[] @relation("MemoryCover")

  @@id([memoryId, fileId])
  @@unique([fileId], map: "memory_files_file_unique")
  @@unique([memoryId, position], map: "memory_files_memory_position_unique")
  @@map("memory_files")
}

model OutboxEvent {
  id                     String    @id @default(dbgenerated("private.uuid_v7()")) @db.Uuid
  entityType             String    @map("entity_type")
  entityId               String    @map("entity_id")
  eventType              String    @map("event_type")
  payload                Json      @db.JsonB
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  publishedAt            DateTime? @map("published_at") @db.Timestamptz(6)
  publishAttemptCount    Int       @default(0) @map("publish_attempt_count")
  lastPublishErrorCode   String?   @map("last_publish_error_code")

  @@map("outbox_event")
}
