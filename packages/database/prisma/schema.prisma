generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String        @id
  name          String
  email         String        @unique
  emailVerified Boolean       @default(false) @map("email_verified")
  image         String?
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  sessions      Session[]
  accounts      Account[]
  createdSpaces Space[]       @relation("SpaceCreator")
  updatedSpaces Space[]       @relation("SpaceUpdater")
  spaceMembers  SpaceMember[]
  fileUploads   FileUpload[]
  memories      Memory[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime @map("expires_at")
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verification")
}

enum SpaceMemberRole {
  owner
  partner

  @@map("space_member_role")
}

model Space {
  id                  String        @id @default(dbgenerated("private.uuid_v7()")) @db.Uuid
  name                String
  startDate           DateTime      @map("start_date") @db.Date
  inviteCode          String?       @map("invite_code")
  inviteCodeExpiresAt DateTime?     @map("invite_code_expires_at") @db.Timestamptz(6)
  createdByUserId     String        @map("created_by_user_id")
  createdByUser       User          @relation("SpaceCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  updatedByUserId     String        @map("updated_by_user_id")
  updatedByUser       User          @relation("SpaceUpdater", fields: [updatedByUserId], references: [id], onDelete: Restrict)
  deletedAt           DateTime?     @map("deleted_at") @db.Timestamptz(6)
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  members             SpaceMember[]
  fileUploads         FileUpload[]
  memories            Memory[]

  @@index([createdByUserId], map: "spaces_created_by_user_id")
  @@index([updatedByUserId], map: "spaces_updated_by_user_id")
  @@map("spaces")
}

model SpaceMember {
  id                    String          @id @default(dbgenerated("private.uuid_v7()")) @db.Uuid
  spaceId               String          @map("space_id") @db.Uuid
  space                 Space           @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId                String          @map("user_id")
  user                  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName           String          @map("display_name")
  role                  SpaceMemberRole
  onboardingCompletedAt DateTime?       @map("onboarding_completed_at") @db.Timestamptz(6)
  deletedAt             DateTime?       @map("deleted_at") @db.Timestamptz(6)
  createdAt             DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdMemories       Memory[]

  @@unique([id, userId, spaceId], map: "space_members_id_user_space_unique")
  @@unique([id, spaceId], map: "space_members_id_space_unique")
  @@index([spaceId], map: "space_members_space_id")
  @@map("space_members")
}

enum FileCategory {
  image

  @@map("file_category")
}

enum FileUploadPurpose {
  memory_image

  @@map("file_upload_purpose")
}

enum FileUploadStatus {
  issued
  finalizing
  finalized
  consumed
  failed

  @@map("file_upload_status")
}

enum MemoryVisibility {
  timeline
  vault

  @@map("memory_visibility")
}

enum MemoryAssetType {
  image

  @@map("memory_asset_type")
}

enum MemoryObjectVariant {
  original
  cover
  detail

  @@map("memory_object_variant")
}

enum MemoryObjectStatus {
  pending
  processing
  ready
  failed

  @@map("memory_object_status")
}

model FileUpload {
  id                 String            @id @default(dbgenerated("private.uuid_v7()")) @db.Uuid
  uploaderUserId     String            @map("uploader_user_id")
  uploader           User              @relation(fields: [uploaderUserId], references: [id], onDelete: Restrict)
  spaceId            String?           @map("space_id") @db.Uuid
  space              Space?            @relation(fields: [spaceId], references: [id], onDelete: Restrict)
  category           FileCategory
  purpose            FileUploadPurpose
  originalFilename   String            @map("original_filename")
  declaredMimeType   String            @map("declared_mime_type")
  declaredByteSize   Int               @map("declared_byte_size")
  verifiedMimeType   String?           @map("verified_mime_type")
  verifiedByteSize   Int?              @map("verified_byte_size")
  stagingKey         String            @unique(map: "file_uploads_staging_key_unique") @map("staging_key")
  intendedFinalKey   String            @unique(map: "file_uploads_final_key_unique") @map("intended_final_key")
  status             FileUploadStatus  @default(issued)
  uploadUrlExpiresAt DateTime          @map("upload_url_expires_at") @db.Timestamptz(6)
  attachmentDeadline DateTime          @map("attachment_deadline") @db.Timestamptz(6)
  leaseToken         String?           @map("lease_token") @db.Uuid
  leaseExpiresAt     DateTime?         @map("lease_expires_at") @db.Timestamptz(6)
  consumedAt         DateTime?         @map("consumed_at") @db.Timestamptz(6)
  failureCode        String?           @map("failure_code")
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  assets             MemoryAsset[]

  @@unique([id, spaceId], map: "file_uploads_id_space_unique")
  @@index([uploaderUserId, spaceId, status, attachmentDeadline], map: "file_uploads_owner_eligibility")
  @@index([status, attachmentDeadline], map: "file_uploads_status_deadline")
  @@map("file_uploads")
}

model Memory {
  id                  String           @id @default(dbgenerated("private.uuid_v7()")) @db.Uuid
  spaceId             String           @map("space_id") @db.Uuid
  space               Space            @relation(fields: [spaceId], references: [id], onDelete: Restrict)
  createdByUserId     String           @map("created_by_user_id")
  createdByUser       User             @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  createdByMemberId   String           @map("created_by_member_id") @db.Uuid
  createdByMember     SpaceMember      @relation(fields: [createdByMemberId, createdByUserId, spaceId], references: [id, userId, spaceId], onDelete: Restrict, onUpdate: NoAction)
  coverAssetId        String?          @map("cover_asset_id") @db.Uuid
  coverAsset          MemoryAsset?     @relation("MemoryCover", fields: [coverAssetId, id], references: [id, memoryId], onDelete: NoAction, onUpdate: NoAction)
  title               String
  description         String?
  location            String?
  memoryDate          DateTime         @map("memory_date") @db.Date
  visibility          MemoryVisibility
  deletedAt           DateTime?        @map("deleted_at") @db.Timestamptz(6)
  idempotencyKey      String           @map("idempotency_key") @db.Uuid
  creationRequestHash String           @map("creation_request_hash")
  createdAt           DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  assets              MemoryAsset[]    @relation("MemoryAssets")

  @@unique([spaceId, createdByUserId, idempotencyKey], map: "memories_creation_key_unique")
  @@unique([id, spaceId], map: "memories_id_space_unique")
  @@index([createdByMemberId, createdByUserId, spaceId], map: "memories_creator_membership")
  @@map("memories")
}

model MemoryAsset {
  id                       String              @id @default(dbgenerated("private.uuid_v7()")) @db.Uuid
  spaceId                  String              @map("space_id") @db.Uuid
  memoryId                 String              @map("memory_id") @db.Uuid
  memory                   Memory              @relation("MemoryAssets", fields: [memoryId, spaceId], references: [id, spaceId], onDelete: Restrict, onUpdate: NoAction)
  uploadId                 String              @unique(map: "memory_assets_upload_unique") @map("upload_id") @db.Uuid
  upload                   FileUpload          @relation(fields: [uploadId, spaceId], references: [id, spaceId], onDelete: Restrict, onUpdate: NoAction)
  assetType                MemoryAssetType     @default(image) @map("asset_type")
  position                 Int                 @db.SmallInt
  generationRecipeVersion  Int                 @default(1) @map("generation_recipe_version")
  processingLeaseToken     String?             @map("processing_lease_token") @db.Uuid
  processingLeaseExpiresAt DateTime?           @map("processing_lease_expires_at") @db.Timestamptz(6)
  createdAt                DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  objects                  MemoryAssetObject[]
  coveredMemories          Memory[]            @relation("MemoryCover")

  @@unique([memoryId, position], map: "memory_assets_memory_position_unique")
  @@unique([id, memoryId], map: "memory_assets_id_memory_unique")
  @@map("memory_assets")
}

model MemoryAssetObject {
  id          String              @id @default(dbgenerated("private.uuid_v7()")) @db.Uuid
  assetId     String              @map("asset_id") @db.Uuid
  asset       MemoryAsset         @relation(fields: [assetId], references: [id], onDelete: Restrict)
  variantType MemoryObjectVariant @map("variant_type")
  objectPath  String              @unique(map: "memory_asset_objects_path_unique") @map("object_path")
  status      MemoryObjectStatus  @default(pending)
  mimeType    String?             @map("mime_type")
  byteSize    Int?                @map("byte_size")
  failureCode String?             @map("failure_code")
  readyAt     DateTime?           @map("ready_at") @db.Timestamptz(6)
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([assetId, variantType], map: "memory_asset_objects_asset_variant_unique")
  @@map("memory_asset_objects")
}

model OutboxEvent {
  id                   String    @id @default(dbgenerated("private.uuid_v7()")) @db.Uuid
  aggregateType        String    @map("aggregate_type")
  aggregateId          String    @map("aggregate_id")
  eventType            String    @map("event_type")
  schemaVersion        Int       @default(1) @map("schema_version")
  payload              Json      @db.JsonB
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  publishedAt          DateTime? @map("published_at") @db.Timestamptz(6)
  publicationAttempts  Int       @default(0) @map("publication_attempts")
  lastPublicationError String?   @map("last_publication_error")

  @@map("outbox_event")
}
