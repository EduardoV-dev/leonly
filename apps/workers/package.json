{
  "name": "workers",
  "private": true,
  "version": "0.1.0",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm --filter 'workers^...' build && tsc -p tsconfig.build.json",
    "typecheck": "pnpm --filter 'workers^...' build && tsc -p tsconfig.json",
    "check": "pnpm exec biome check .",
    "test:run": "pnpm --filter 'workers^...' build && vitest run",
    "prisma:generate": "pnpm --filter @leonly/database prisma:generate"
  },
  "dependencies": {
    "@leonly/database": "workspace:*",
    "@leonly/utils": "workspace:*",
    "pino": "^10.1.0",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@types/aws-lambda": "^8.10.159",
    "@types/node": "^22.20.4",
    "pino-pretty": "^13.1.3",
    "typescript": "^6.0.2",
    "unplugin-swc": "^2.0.0",
    "vitest": "^2.1.4"
  }
}
