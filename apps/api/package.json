{
  "name": "api",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "build": "pnpm prisma:generate && pnpm build:app",
    "build:app": "tsc -p tsconfig.build.json",
    "build:image": "docker buildx build --platform linux/amd64 --provenance=false --load -f Dockerfile -t leonly-api ../..",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/src/main.js",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:migrate": "prisma migrate deploy --schema prisma/schema.prisma",
    "prisma:migrate:dev": "prisma migrate dev --schema prisma/schema.prisma",
    "test": "vitest run",
    "test:run": "vitest run",
    "typecheck": "pnpm prisma:generate && tsc --noEmit -p tsconfig.json",
    "lint": "pnpm exec biome lint .",
    "format": "pnpm exec biome format --write .",
    "check": "pnpm exec biome check ."
  },
  "dependencies": {
    "@codegenie/serverless-express": "^4.17.1",
    "@nestjs/common": "^11.1.16",
    "@nestjs/core": "^11.1.16",
    "@nestjs/platform-express": "^11.1.16",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "better-auth": "1.6.23",
    "dotenv": "^18.0.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@types/aws-lambda": "^8.10.159",
    "@types/express": "^5.0.3",
    "@types/node": "^22.20.4",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^2.1.4",
    "prisma": "7.10.0",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
