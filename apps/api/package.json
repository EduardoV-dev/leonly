{
  "name": "api",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "build": "pnpm --filter 'api^...' build && pnpm build:app",
    "build:app": "nest build",
    "build:image": "docker buildx build --platform linux/amd64 --provenance=false --load -f Dockerfile -t leonly-api ../..",
    "dev": "pnpm --filter 'api^...' build && nest start --watch",
    "start": "pnpm --filter 'api^...' build && nest start",
    "start:debug": "pnpm --filter 'api^...' build && nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "prisma:generate": "pnpm --filter @leonly/database prisma:generate",
    "prisma:migrate": "pnpm --filter @leonly/database exec prisma migrate deploy --config ../../apps/api/prisma.config.ts",
    "prisma:migrate:dev": "pnpm --filter @leonly/database exec prisma migrate dev --config ../../apps/api/prisma.config.ts",
    "test": "pnpm --filter 'api^...' build && vitest run",
    "test:run": "pnpm --filter 'api^...' build && pnpm --filter @leonly/utils test:run && vitest run",
    "typecheck": "pnpm --filter 'api^...' build && tsc --noEmit -p tsconfig.json",
    "lint": "pnpm exec biome lint .",
    "format": "pnpm exec biome format --write .",
    "check": "pnpm exec biome check ."
  },
  "dependencies": {
    "@codegenie/serverless-express": "^4.17.1",
    "@leonly/database": "workspace:*",
    "@leonly/utils": "workspace:*",
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-express": "^12.1.2",
    "@nestjs/swagger": "^12.0.2",
    "@scalar/nestjs-api-reference": "^1.2.23",
    "@upstash/ratelimit": "2.0.6",
    "@upstash/redis": "^1.39.0",
    "better-auth": "1.6.23",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^18.0.3",
    "nestjs-pino": "^5.2.1",
    "pino": "^10.1.0",
    "pino-http": "^11.0.0",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.4",
    "uuid": "11"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@nestjs/cli": "^12.0.8",
    "@swc/core": "^1.16.2",
    "@types/aws-lambda": "^8.10.159",
    "@types/express": "^5.0.3",
    "@types/node": "^22.20.4",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^2.1.4",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.1.4",
    "typescript": "^6.0.2",
    "unplugin-swc": "^2.0.0",
    "vitest": "^2.1.4"
  }
}
