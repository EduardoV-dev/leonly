{
  "name": "api",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "build": "pnpm --filter @leonly/utils build && pnpm prisma:generate && pnpm build:app",
    "build:app": "tsc -p tsconfig.build.json",
    "build:image": "docker buildx build --platform linux/amd64 --provenance=false --load -f Dockerfile -t leonly-api ../..",
    "dev": "nest start --watch",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:migrate": "prisma migrate deploy --schema prisma/schema.prisma",
    "prisma:migrate:dev": "prisma migrate dev --schema prisma/schema.prisma",
    "test": "pnpm --filter @leonly/utils build && vitest run",
    "test:run": "pnpm --filter @leonly/utils build && pnpm --filter @leonly/utils test:run && vitest run",
    "typecheck": "pnpm --filter @leonly/utils build && pnpm prisma:generate && tsc --noEmit -p tsconfig.json",
    "lint": "pnpm exec biome lint .",
    "format": "pnpm exec biome format --write .",
    "check": "pnpm exec biome check ."
  },
  "dependencies": {
    "@leonly/utils": "workspace:*",
    "@codegenie/serverless-express": "^4.17.1",
    "@nestjs/common": "^11.1.16",
    "@nestjs/core": "^11.1.16",
    "@nestjs/platform-express": "^11.1.16",
    "@nestjs/swagger": "^11.4.7",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@scalar/nestjs-api-reference": "^1.2.23",
    "better-auth": "1.6.23",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^18.0.3",
    "nestjs-pino": "^5.2.1",
    "pino": "^10.1.0",
    "pino-http": "^11.0.0",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@nestjs/cli": "^11",
    "@swc/core": "^1.16.2",
    "@types/aws-lambda": "^8.10.159",
    "@types/express": "^5.0.3",
    "@types/node": "^22.20.4",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^2.1.4",
    "pino-pretty": "^13.1.3",
    "prisma": "7.10.0",
    "supertest": "^7.1.4",
    "typescript": "^6.0.2",
    "unplugin-swc": "^2.0.0",
    "vitest": "^2.1.4"
  }
}
